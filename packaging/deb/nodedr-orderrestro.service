[Unit]
Description=BillBaaz (Docker Compose)
Documentation=https://BillBaaz.nodedr.com/docs
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=900
ExecStart=/usr/bin/docker compose --project-name billbaaz --env-file /etc/billbaaz/billbaaz.env -f /usr/lib/billbaaz/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --project-name billbaaz --env-file /etc/billbaaz/billbaaz.env -f /usr/lib/billbaaz/docker-compose.yml down

[Install]
WantedBy=multi-user.target
