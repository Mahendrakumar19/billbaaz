#!/bin/sh
set -e
systemctl daemon-reload >/dev/null 2>&1 || true
if [ "$1" = purge ]; then
  echo "billbaaz: your data stays in Docker volumes (billbaaz_pg_data, billbaaz_uploads_data, billbaaz_state) and your settings and generated passwords in /etc/billbaaz/billbaaz.env, so a later reinstall picks up where you left off. To delete everything for good: sudo docker compose --project-name billbaaz down -v ; sudo rm -rf /etc/billbaaz" >&2
fi
exit 0
